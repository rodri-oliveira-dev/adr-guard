{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodri-oliveira-dev/adr-guard/schemas/adr-fitness-rules-v1.schema.json",
  "title": "ADR Guard architecture fitness rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stableId", "path"],
      "properties": {
        "stableId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": { "type": "string", "pattern": "^[^\\\\/][^\\\\]*\\.md$", "maxLength": 1024 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects"],
      "properties": {
        "projects": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[^\\\\/][^\\\\]*\\.csproj$", "maxLength": 1024 } }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "onInconclusive"],
      "properties": {
        "severity": { "enum": ["error", "warning", "notice"] },
        "onInconclusive": { "const": "unknown" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision", "scope", "check", "evidence", "failure", "gate"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "decision": { "$ref": "#/$defs/decision" },
        "scope": { "$ref": "#/$defs/scope" },
        "check": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["type", "from", "to"], "properties": { "type": { "const": "forbid-project-reference" }, "from": { "type": "string" }, "to": { "type": "string" } } },
            { "type": "object", "additionalProperties": false, "required": ["type", "testId"], "properties": { "type": { "const": "external-test" }, "testId": { "type": "string", "minLength": 1, "maxLength": 256 } } }
          ]
        },
        "evidence": { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "source": { "enum": ["dotnet-project-reference", "external-test-report"] } } },
        "failure": { "$ref": "#/$defs/failure" },
        "gate": { "type": "boolean" }
      }
    }
  }
}
