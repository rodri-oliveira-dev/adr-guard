{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adr-impact-map-v1.schema.json",
  "title": "ADR Guard architecture-impact mapping manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mappings"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/mapping" }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stableId", "path"],
      "properties": {
        "stableId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^/].*\\.md$"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "patterns", "relationship", "reason"],
      "properties": {
        "decision": { "$ref": "#/$defs/decision" },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^/].*$"
          }
        },
        "relationship": {
          "enum": ["governs", "implements", "constrains", "depends-on"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  }
}
