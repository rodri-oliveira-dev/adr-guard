{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodri-oliveira-dev/adr-guard/schemas/adr-fitness-evidence-v1.schema.json",
  "title": "ADR Guard external fitness evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producer", "artifact", "observations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "producer": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "version": { "type": "string", "minLength": 1, "maxLength": 64 } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["runId", "id", "sha256"], "properties": { "runId": { "type": "string", "minLength": 1, "maxLength": 256 }, "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" } } },
    "observations": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "type": "object", "additionalProperties": false, "required": ["testId", "status"], "properties": { "testId": { "type": "string", "minLength": 1, "maxLength": 256 }, "status": { "enum": ["passed", "failed", "skipped", "error"] }, "observedAt": { "type": "string", "format": "date-time" } } } }
  }
}
