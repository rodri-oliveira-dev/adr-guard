<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>adr-guard</AssemblyName>
    <RootNamespace>AdrGuard</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>adr-guard</ToolCommandName>

    <PackageId>RodriOliveira.AdrGuard</PackageId>
    <VersionPrefix>1.8.0</VersionPrefix>
    <Title>ADR Guard - Architecture Decision Records Validator</Title>
    <Authors>Rodrigo de Oliveira</Authors>
    <Description>Validate, index, create, draft, review, analyze impact, and verify ADR-backed architectural drift from the command line. ADR Guard provides deterministic Markdown checks, explicit mappings, bounded fitness evidence, offline ADR generation, and optional human-reviewed AI assistance.</Description>
    <PackageTags>adr;architecture;architecture-decision-record;architecture-decision-records;dotnet;dotnet-tool;cli;validation;markdown;documentation;templates;adr-generation;adr-review;architecture-impact;architecture-drift;fitness-functions;ai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon-nuget.png</PackageIcon>
    <PackageReleaseNotes Condition="'$(VersionPrefix)' == '1.8.0'">Coordinates the documented CLI contracts used by ADR Guard for VS Code 1.1.0 and ADR Guard MCP 1.0.0.
Keeps validation, form, JSON/SARIF, impact, drift, review, catalog and exit-code contracts backward compatible.
Clarifies independent component versioning, verified compatibility boundaries and advisory AI/MCP semantics.
Full release notes: https://github.com/rodri-oliveira-dev/adr-guard/releases/tag/v1.8.0</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/rodri-oliveira-dev/adr-guard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rodri-oliveira-dev/adr-guard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Copyright>Copyright © 2026 Rodrigo de Oliveira</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="adr-guard-mcp" />
    <InternalsVisibleTo Include="AdrGuard.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../README.pt-BR.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../../images/icon-nuget.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
