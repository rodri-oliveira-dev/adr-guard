<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>adr-guard</AssemblyName>
    <RootNamespace>AdrGuard</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>adr-guard</ToolCommandName>

    <PackageId>RodriOliveira.AdrGuard</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Title>ADR Guard - Architecture Decision Records Validator</Title>
    <Authors>Rodrigo de Oliveira</Authors>
    <Description>Validate and maintain Architecture Decision Records from the command line. ADR Guard checks naming conventions, required sections, statuses, duplicate IDs, ADR references, and supersession links, and generates deterministic Markdown indexes.</Description>
    <PackageTags>adr;architecture;architecture-decision-record;architecture-decision-records;dotnet;dotnet-tool;cli;validation;markdown;documentation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/rodri-oliveira-dev/adr-guard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rodri-oliveira-dev/adr-guard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Copyright>Copyright © 2026 Rodrigo de Oliveira</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdrGuard.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../README.pt-BR.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
