<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>adr-guard</AssemblyName>
    <RootNamespace>AdrGuard</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>adr-guard</ToolCommandName>

    <PackageId>RodriOliveira.AdrGuard</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Title>ADR Guard</Title>
    <Authors>Rodrigo de Oliveira</Authors>
    <Description>A lightweight .NET tool for validating and indexing Architecture Decision Records.</Description>
    <PackageTags>adr;architecture;architecture-decision-records;dotnet-tool;cli;validation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/rodri-oliveira-dev/adr-guard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rodri-oliveira-dev/adr-guard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdrGuard.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
