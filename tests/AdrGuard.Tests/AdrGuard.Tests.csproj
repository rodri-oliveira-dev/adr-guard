<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AdrGuard.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AdrGuard/AdrGuard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures/Templates/*.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/Review/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/Madr4/*.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/Impact/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/schemas/adr-impact-map-v1.schema.json"
          Link="Schemas/adr-impact-map-v1.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/schemas/adr-impact-report-v1.schema.json"
          Link="Schemas/adr-impact-report-v1.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
